{
  "expo": {
    "name": "PautangBai",
    "slug": "pautangbai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pautangbai",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.pautangbai.app",
      "predictiveBackGestureEnabled": false
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173D35"
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
